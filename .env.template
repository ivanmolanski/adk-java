###############################################
# MD AESTHETICS ENVIRONMENT CONFIGURATION     #
# Copy this file to .env and fill all secrets #
# Do NOT commit the real .env file            #
###############################################

############################
# Core Server Configuration
############################
HOST=0.0.0.0
PORT=3453
SERVER_PORT=3453
DEBUG=true
LOG_LEVEL=info
ENVIRONMENT=development
NODE_ENV=development
SECRET_KEY=replace-with-strong-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

############################
# Service Base URLs (Frontend consumption)
############################
NEXT_PUBLIC_VIRAL_SERVICE_URL=http://localhost:3453/viral-service
NEXT_PUBLIC_API_BASE_URL=http://localhost:3453/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:3453

############################
# Database Configuration (Choose ONE)
############################
# Local SQLite (dev quick-start)
DB_URL=sqlite+aiosqlite:///./dev.db

# Postgres (uncomment & configure for production)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mdaesthetics_db

############################
# Supabase (Optional if used for auth/storage)
############################
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

############################
# AI / LLM Providers (GitHub Models ONLY)
############################
AI_DEFAULT_MODEL=gpt-4o
GITHUB_TOKEN="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"
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions
RUN_LIVE_AI=0
REFINE_CAPTIONS=true

############################
# Apify Scraping (Viral Intelligence)
############################
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-posts-scraper
APIFY_TIKTOK_ACTOR=apify/tiktok-scraper
APIFY_MAX_ITEMS=40

############################
# Email Dispatch (Set either SendGrid OR SMTP)
############################
SENDGRID_API_KEY=
EMAIL_FROM=alerts@mdaesthetics.local
EMAIL_FROM_NAME=MD Aesthetics Intelligence

# SMTP Fallback (leave blank if using SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

############################
# Scheduler Controls
############################
ENABLE_SCHEDULER=0
# Future: override cron via env if implemented
# SCRAPE_CRON="0 13 * * *"
# DIGEST_CRON="30 13 * * *"

############################
# Feature Flags
############################
# Force refinement second-pass polishing of captions
REFINE_CAPTIONS=true

############################
# Security Notes
############################
# 1. NEVER commit your real .env
# 2. Rotate tokens regularly
# 3. GitHub token: models scope ONLY (principle of least privilege)
# 4. If using Supabase, treat Service Role key as secret (server-side only)

