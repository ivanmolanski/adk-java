# Non-sensitive environment variables for Firebase Functions
# Sensitive values (API keys, tokens) are managed via Firebase Secrets

# Pub/Sub Topics
PUBSUB_TOPIC_VIRAL_POST_CREATED=viral-post-created
PUBSUB_TOPIC_ORCHESTRATION_COMPLETED=orchestration-completed

# Google CSE Terms (comma-separated, can be overridden per run)
GOOGLE_CSE_TERMS=medical aesthetics,skincare treatments,facial procedures,anti-aging treatments,cosmetic procedures,dermal fillers,botox treatments,laser treatments,skin rejuvenation,medical spa services

# Enable/Disable features
ENABLE_GLOBAL_CSE=true
SCRAPING_ENABLED=true

# Logging and Monitoring
LOG_LEVEL=info
METRICS_ENABLED=true
