{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions for viral scraper and integration",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "deploy": "firebase deploy --only functions",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@genkit-ai/googleai": "0.5.0-rc.8",
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/pubsub": "^4.8.0",
    "@types/node-fetch": "^2.6.13",
    "apify-client": "^2.11.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "genkit": "^1.17.1",
    "googleapis": "^144.0.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.6.3"
  }
}
