# Social Media OAuth2 Configuration
# You need to obtain these from TikTok and Instagram Developer Platforms

# TikTok API Configuration
# Get these from https://developers.tiktok.com/
TIKTOK_CLIENT_ID=your-tiktok-client-id-here
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret-here

# Instagram API Configuration  
# Get these from https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=your-instagram-client-id-here
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret-here

# Application Configuration
APP_BASE_URL=http://localhost:8081

# Google Cloud Configuration (already set up)
GOOGLE_CLOUD_PROJECT=contentforge-ai-ygy25
GOOGLE_API_KEY=your-google-api-key-here