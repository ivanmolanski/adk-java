# Copy to .env and fill in values. Never commit real secrets.
# Firebase / Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCP_PROJECT=contentforge-ai-ygy25

# Firebase Configuration (Web) - REGENERATE THESE KEYS!
NEXT_PUBLIC_FIREBASE_API_KEY=your_new_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=contentforge-ai-ygy25.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=contentforge-ai-ygy25
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=contentforge-ai-ygy25.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=51060608349
NEXT_PUBLIC_FIREBASE_APP_ID=your_new_firebase_app_id_here

# Optional API keys for contrib tests (kept empty by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Social Media OAuth2 Configuration for Viral Service
# TikTok OAuth2 - Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Instagram OAuth2 - Get from: https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Application Configuration
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8081

# Security Configuration
OAUTH2_REDIRECT_URI_BASE=http://localhost:8081/viral-service

# Media Upload Configuration (for Instagram image posts)
MEDIA_UPLOAD_URL=https://your-media-host.com/upload
