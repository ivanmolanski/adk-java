# Python Backend Configuration
HOST=0.0.0.0
PORT=3453
DEBUG=true
LOG_LEVEL=info

# Database Configuration (PostgreSQL/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/mdaesthetics_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Next.js Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3453/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:3453

# AI/LLM API Configuration
# OpenRouter API for LLM functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Social Media Scraping APIs

# Apify Configuration for Instagram Scraping
# Get your token from: https://console.apify.com/account#/integrations
APIFY_TOKEN=your-apify-token-here

# Social Media Scraping APIs

# Apify Configuration for Instagram/TikTok Scraping
# Get your token from: https://console.apify.com/account#/integrations
APIFY_TOKEN=your-apify-token-here

# Social Media OAuth2 Configuration
# TikTok: Get from https://developers.tiktok.com/
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# Instagram: Get from https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Email Configuration (for digest delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@mdaesthetics.ca
DAILY_DIGEST_RECIPIENTS=christine.carrer@hotmail.com,dalkeith@golden.net

# Security Configuration
SECRET_KEY=your-secret-key-for-jwt-tokens
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Production Configuration
NODE_ENV=development
ENVIRONMENT=development